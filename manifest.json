{
  "manifest_version": 3,
  "name": "WCAG 2.1 Compliance Checker",
  "version": "1.0",
  "description": "Checks current page for WCAG 2.1 compliance issues.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
